@if (ViewBag.Message != null)
{
    <div class="alert alert-info" role="alert">
        @ViewBag.Message
    </div>
}

<form method="post"
      asp-controller="Home"
      asp-action="UploadExcel"
      enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <div class="row">
        <label for="file">Select Excel File</label>
        <input type="file"
               id="file"
               name="file"
               accept=".xls,.xlsx,.xlsb"
               required />
    </div>

    <br />

    <div class="row">
        <div class="col-3">
            <input type="submit"
                   class="btn btn-dark"
                   value="Upload Excel File" />
        </div>
    </div>

</form>
